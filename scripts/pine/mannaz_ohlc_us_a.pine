//@version=6
// MANNAZ — eksport dziennych OHLC, batch A (16 spolek US)
//
// Wykres bazowy: AMEX:SPY, interwal 1D.
//   - korekta o dywidendy WYLACZONA (T6: szereg do stopow i ATR)
//   - bez przeliczania waluty
//   - sesja zwykla, bez extended hours
//   - przewinac w lewo do ~2022-09 (ok. 1000 sesji) PRZED eksportem
//
// OHLC samego SPY wychodzi do CSV automatycznie i sluzy jako benchmark (M57/M58).
// Eksport: menu "..." -> Export chart data...

indicator("Mannaz OHLC · US batch A", overlay = false, max_bars_back = 5000)

f(simple string sym) =>
    request.security(sym, timeframe.period, [high, low, close], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol = true)

D = display.data_window

[h01, l01, c01] = f("NYSE:NOW")
plot(h01, "NOW_h", display = D), plot(l01, "NOW_l", display = D), plot(c01, "NOW_c", display = D)

[h02, l02, c02] = f("NASDAQ:META")
plot(h02, "META_h", display = D), plot(l02, "META_l", display = D), plot(c02, "META_c", display = D)

[h03, l03, c03] = f("NYSE:SE")
plot(h03, "SE_h", display = D), plot(l03, "SE_l", display = D), plot(c03, "SE_c", display = D)

