//@version=6
// MANNAZ — eksport dziennych OHLC, batch B (16 spolek US)
//
// Wykres bazowy: NASDAQ:QQQ, interwal 1D. Ustawienia jak w batchu A:
//   korekta o dywidendy WYLACZONA, bez przeliczania waluty, sesja zwykla,
//   przewinac w lewo do ~2022-09 przed eksportem.
//
// OHLC samego QQQ wychodzi automatycznie — drugi benchmark obok SPY (M57/M58).
// Eksport: menu "..." -> Export chart data... -> format czasu ISO.
// KONTROLA: pierwszy wiersz pliku ma miec 54 kolumny (6 dla QQQ + 16 x 3).
// Skrypt sprawdza, czy siedzi na wykresie z kalendarzem NYSE (od 2026-09-25).

indicator("Mannaz OHLC · US batch B", overlay = false, max_bars_back = 5000)

if syminfo.timezone != "America/New_York"
    runtime.error("Mannaz US-B: wykres bazowy musi byc z gieldy USA (np. NASDAQ:QQQ). Teraz: " + syminfo.tickerid)

f(simple string sym) =>
    request.security(sym, timeframe.period, [high, low, close], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol = true)

D = display.all

[h01, l01, c01] = f("NASDAQ:GRAB")
plot(h01, "GRAB_h", display = D), plot(l01, "GRAB_l", display = D), plot(c01, "GRAB_c", display = D)

[h02, l02, c02] = f("NASDAQ:TSLA")
plot(h02, "TSLA_h", display = D), plot(l02, "TSLA_l", display = D), plot(c02, "TSLA_c", display = D)

[h03, l03, c03] = f("NYSE:SPOT")
plot(h03, "SPOT_h", display = D), plot(l03, "SPOT_l", display = D), plot(c03, "SPOT_c", display = D)

